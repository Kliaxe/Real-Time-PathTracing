{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },

  "configurePresets": [
    {
      "name": "base-x64",
      "displayName": "Base (x64)",
      "description": "Common standalone LLVM MinGW settings for all x64 presets.",
      "hidden": true,

      "generator": "Ninja",

      "binaryDir": "${sourceDir}/Build/${presetName}",

      "environment": {
        "PATH": "$env{LOCALAPPDATA}/LLVM-MinGW/bin;$env{LOCALAPPDATA}/Microsoft/WinGet/Links;$penv{PATH}"
      },

      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{LOCALAPPDATA}/LLVM-MinGW/bin/x86_64-w64-mingw32-clang.exe",
        "CMAKE_CXX_COMPILER": "$env{LOCALAPPDATA}/LLVM-MinGW/bin/x86_64-w64-mingw32-clang++.exe",
        "CMAKE_RC_COMPILER": "x86_64-w64-mingw32-windres",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/Install/${presetName}",
        "CMAKE_MAKE_PROGRAM": "ninja"
      }
    },

    {
      "name": "x64-Debug",
      "displayName": "x64 Debug",
      "description": "Standalone LLVM MinGW + Ninja Debug build.",
      "inherits": "base-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64-Release",
      "displayName": "x64 Release",
      "description": "Standalone LLVM MinGW + Ninja Release build.",
      "inherits": "base-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x64-RelWithDebInfo",
      "displayName": "x64 RelWithDebInfo",
      "description": "Standalone LLVM MinGW + Ninja RelWithDebInfo build.",
      "inherits": "base-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "x64-MinSizeRel",
      "displayName": "x64 MinSizeRel",
      "description": "Standalone LLVM MinGW + Ninja MinSizeRel build.",
      "inherits": "base-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "base-linux",
      "displayName": "Base Linux",
      "description": "Common Clang + Ninja settings for Linux presets.",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/Install/${presetName}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-Debug",
      "displayName": "Linux Debug",
      "inherits": "base-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-Release",
      "displayName": "Linux Release",
      "inherits": "base-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "x64-Debug",
      "displayName": "Build x64 Debug",
      "configurePreset": "x64-Debug"
    },
    {
      "name": "x64-Release",
      "displayName": "Build x64 Release",
      "configurePreset": "x64-Release"
    },
    {
      "name": "x64-RelWithDebInfo",
      "displayName": "Build x64 RelWithDebInfo",
      "configurePreset": "x64-RelWithDebInfo"
    },
    {
      "name": "x64-MinSizeRel",
      "displayName": "Build x64 MinSizeRel",
      "configurePreset": "x64-MinSizeRel"
    },
    {
      "name": "linux-Debug",
      "displayName": "Build Linux Debug",
      "configurePreset": "linux-Debug"
    },
    {
      "name": "linux-Release",
      "displayName": "Build Linux Release",
      "configurePreset": "linux-Release"
    }
  ],

  "testPresets": [
    {
      "name": "x64-Debug",
      "displayName": "Test x64 Debug",
      "configurePreset": "x64-Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "x64-Release",
      "displayName": "Test x64 Release",
      "configurePreset": "x64-Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-Debug",
      "displayName": "Test Linux Debug",
      "configurePreset": "linux-Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-Release",
      "displayName": "Test Linux Release",
      "configurePreset": "linux-Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
