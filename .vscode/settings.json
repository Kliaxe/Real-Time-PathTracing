{
  // Use CMake Tools for IntelliSense include paths/defines.
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",

  // Always use your CMakePresets.json (keeps VS Code + build consistent).
  "cmake.useCMakePresets": "always",

  // Build when launching (cmake.launchTargetPath / cmake.launchTargetDirectory triggers a build).
  "cmake.buildBeforeRun": true,

  // LLVM MinGW provides the compiler, linker, C++ runtime, and Windows headers.
  "cmake.useVsDeveloperEnvironment": "never",

  // Reasonable defaults; you can change these from the CMake Tools status bar.
  "cmake.configurePreset": "x64-Debug",
  "cmake.buildPreset": "x64-Debug"
}
